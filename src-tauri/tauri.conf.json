{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zona de Controle",
  "version": "../package.json",
  "identifier": "com.brunostrufaldi.zonadecontrole",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Zona de Controle",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0B0B0C"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bruno Strufaldi",
    "category": "Productivity",
    "shortDescription": "Hub de produtividade, sistema e finanças",
    "longDescription": "Zona de Controle é um aplicativo desktop local-first que reúne produtividade pessoal, monitoramento seguro do computador e gestão financeira.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyREYzMjBDQUMxRTkyOEMKUldTTWtoNnNERExmb3BoRU9sb1ZrSElOdnN6Qi9CV1RGOEQrc2tYYjZTc0Q1U2daMmpIMUtLenIK",
      "endpoints": [
        "https://github.com/BrunoStrufaldi/Zona-de-controle/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
